{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cp greybox/stage.html index.html",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/stage.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/greybox/stage.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "/greybox/data/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "/greybox/src/:path*"
    }
  ]
}
